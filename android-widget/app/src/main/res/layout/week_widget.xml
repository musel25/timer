<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_background"
    android:orientation="vertical"
    android:padding="16dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:letterSpacing="0.14"
            android:text="@string/today"
            android:textColor="#48D1C3"
            android:textSize="11sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_refresh"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@drawable/widget_refresh_background"
            android:contentDescription="@string/refresh_tasks"
            android:gravity="center"
            android:text="@string/refresh_symbol"
            android:textColor="#8DE5DC"
            android:textSize="23sp" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/widget_date"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="#F2F5F7"
            android:textSize="17sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/widget_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:textColor="#A9C6C8"
            android:textSize="11sp" />
    </LinearLayout>
    <TextView
        android:id="@+id/widget_tasks"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/widget_task_panel"
        android:ellipsize="end"
        android:gravity="center_vertical"
        android:lineSpacingExtra="5dp"
        android:maxLines="5"
        android:padding="12dp"
        android:text="@string/open_app_to_sign_in"
        android:textColor="#E4EAED"
        android:textSize="13sp" />
    <TextView
        android:id="@+id/widget_account"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:ellipsize="end"
        android:maxLines="1"
        android:text="@string/planner"
        android:textColor="#91A6B0"
        android:textSize="11sp" />
</LinearLayout>
